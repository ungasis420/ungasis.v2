# Analogy: The environment variables template is like a blank lease agreement.
# You copy this form to a new file named .env and fill in your private signatures (API keys).
# You must NEVER show this signed agreement to the public (do not commit .env to git!).

# UNGASIS OS — Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit .env to git (it is in .gitignore)

# Google AI Studio API Key (for Cline + third-party tools)
GOOGLE_AI_API_KEY=your_key_here

# OpenRouter API Key (for multi-model access)
OPENROUTER_API_KEY=your_key_here

# Groq API Key
GROQ_API_KEY=your_key_here

# Together AI API Key
TOGETHER_API_KEY=your_key_here

# Mistral API Key
MISTRAL_API_KEY=your_key_here

# Cerebras API Key
CEREBRAS_API_KEY=your_key_here


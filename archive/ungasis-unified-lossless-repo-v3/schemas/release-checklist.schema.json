{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Release Checklist",
  "type": "object",
  "required": [
    "version",
    "checks"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
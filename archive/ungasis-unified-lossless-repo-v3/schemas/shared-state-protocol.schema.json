{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shared State Protocol",
  "type": "object",
  "required": ["version", "file_lock_rule", "layers"],
  "properties": {
    "version": {"type": "string"},
    "file_lock_rule": {"type": "string"},
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["layer", "file", "writers", "mode"],
        "properties": {
          "layer": {"type": "integer"},
          "file": {"type": "string"},
          "writers": {"type": "array", "items": {"type": "string"}},
          "mode": {"type": "string"}
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Chain",
  "type": "object",
  "required": [
    "name",
    "agents"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "role",
          "allowed_actions"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "allowed_actions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "approval_required_for": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Token Budget",
  "type": "object",
  "required": [
    "default_budget",
    "max_budget",
    "stop_when_uncertain"
  ],
  "properties": {
    "default_budget": {
      "type": "integer",
      "minimum": 1
    },
    "max_budget": {
      "type": "integer",
      "minimum": 1
    },
    "stop_when_uncertain": {
      "type": "boolean"
    },
    "notes": {
      "type": "string"
    }
  }
}

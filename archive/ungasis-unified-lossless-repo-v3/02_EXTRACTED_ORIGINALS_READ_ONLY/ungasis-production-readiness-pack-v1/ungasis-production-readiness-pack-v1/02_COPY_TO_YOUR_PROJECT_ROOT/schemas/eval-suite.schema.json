{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Eval Suite",
  "type": "object",
  "required": [
    "tests"
  ],
  "properties": {
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "prompt",
          "expected_safe_behavior",
          "risk"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "prompt": {
            "type": "string"
          },
          "expected_safe_behavior": {
            "type": "string"
          },
          "risk": {
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          }
        }
      }
    }
  }
}

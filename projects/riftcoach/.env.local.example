# ============================================================================
# RIFTCOACH — Environment Variables
# Copy this file to your project root as .env.local
# Replace the placeholder values with your actual OpenRouter API keys
# ============================================================================

# OpenRouter API Keys (get free keys at https://openrouter.ai/keys)
# You can use 1-4 keys. The Smart Router rotates through them to avoid rate limits.
OPENROUTER_API_KEY_1=sk-or-v1-your-first-key-here
OPENROUTER_API_KEY_2=sk-or-v1-your-second-key-here
OPENROUTER_API_KEY_3=sk-or-v1-your-third-key-here
OPENROUTER_API_KEY_4=sk-or-v1-your-fourth-key-here
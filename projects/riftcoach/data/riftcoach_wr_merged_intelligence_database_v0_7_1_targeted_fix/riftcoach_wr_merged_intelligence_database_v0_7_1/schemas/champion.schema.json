{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://riftcoach.local/schemas/champion.schema.json",
  "title": "Champion",
  "type": "object",
  "required": [
    "id",
    "name",
    "game",
    "not_lol_pc",
    "patch_version",
    "abilities",
    "source_status"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "title": {
      "type": [
        "string",
        "null"
      ]
    },
    "game": {
      "const": "wild_rift"
    },
    "not_lol_pc": {
      "const": true
    },
    "patch_version": {
      "type": "string"
    },
    "brief_description": {
      "type": "string"
    },
    "full_description": {
      "type": "string"
    },
    "classes": {
      "type": "array"
    },
    "roles": {
      "type": "array"
    },
    "positions": {
      "type": "array"
    },
    "lanes": {
      "type": "array"
    },
    "resource": {
      "type": [
        "string",
        "null"
      ]
    },
    "range_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "adaptive_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "ratings": {
      "type": "object"
    },
    "base_stats": {
      "type": "object"
    },
    "abilities": {
      "type": [
        "object",
        "array"
      ]
    },
    "strategy": {
      "type": "object"
    },
    "source_status": {
      "type": "string",
      "enum": [
        "source_verified",
        "source_inferred",
        "generated_rule",
        "generated_archetype",
        "hybrid",
        "source_conflict",
        "user_corrected_pending_revalidation",
        "pending_allowed_source_refresh",
        "source_verified_not_applicable",
        "not_applicable"
      ]
    },
    "provenance": {
      "type": "object"
    }
  },
  "additionalProperties": true
}

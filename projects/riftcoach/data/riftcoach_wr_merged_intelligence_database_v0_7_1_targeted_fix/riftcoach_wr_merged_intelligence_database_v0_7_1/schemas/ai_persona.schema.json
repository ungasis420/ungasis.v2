{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://riftcoach.local/schemas/ai_persona.schema.json",
  "title": "AI Persona",
  "type": "object",
  "required": [
    "persona_id",
    "name",
    "goal",
    "allowed_actions",
    "forbidden_actions"
  ],
  "properties": {
    "persona_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "goal": {
      "type": "string"
    },
    "allowed_actions": {
      "type": "array"
    },
    "forbidden_actions": {
      "type": "array"
    },
    "response_style": {
      "type": "string"
    },
    "source_policy": {
      "type": "string"
    }
  },
  "additionalProperties": true
}

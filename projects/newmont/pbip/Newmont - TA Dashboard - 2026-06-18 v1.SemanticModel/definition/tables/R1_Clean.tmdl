table R1_Clean
	lineageTag: 209da6e5-b088-484d-b136-a09517cb4d44

	measure Total_Requisitions = COUNTROWS(R1_Clean)
		formatString: 0
		lineageTag: f606746d-a7c8-4a46-9dcd-aa86fe788abf

	measure 'Total Filled' =
			
			CALCULATE(
			    COUNTROWS(R1_Clean),
			    R1_Clean[Requisition Status] = "Filled"
			)
		formatString: 0
		lineageTag: 8c39f517-a3c7-4dfa-9fe0-376db924a035

	measure 'Total Cancelled' =
			
			CALCULATE(
			    COUNTROWS(R1_Clean),
			    R1_Clean[Requisition Status] = "Cancelled"
			)
		formatString: 0
		lineageTag: 05f7d33c-034f-4ed0-8f32-8e996254a110

	measure Total_Open =
			
			CALCULATE(
			    COUNTROWS(R1_Clean),
			    R1_Clean[Requisition Status] = "Open"
			)
		formatString: 0
		lineageTag: b385a5c6-5e10-42b6-b3d3-2726e4ce1a6a

	measure 'Total On Hold' =
			
			CALCULATE(
			    COUNTROWS(R1_Clean),
			    R1_Clean[Requisition Status] = "On Hold"
			)
		formatString: 0
		lineageTag: 5cf37b6e-a32f-407e-8ff0-48c42b4f016d

	measure 'Fill Rate' =
			
			DIVIDE(
			    [Total Filled],
			    [Total Filled] + [Total Cancelled],
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 6c7e7d6a-0836-4ee0-b4a2-b953153452d6

	measure 'Cancel Rate' =
			
			DIVIDE(
			    [Total Cancelled],
			    [Total_Requisitions],
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 8175e11d-db57-4d66-a8b1-7ecba92f07f9

	measure 'Avg TTF' =
			
			AVERAGE(R1_Clean[Time to Fill])
		lineageTag: 4f4455ac-4740-4452-82d8-bdb793be643e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Aged 60 Plus' =
			
			CALCULATE(
			    COUNTROWS(R1_Clean),
			    R1_Clean[Requisition Status] = "Open",
			    R1_Clean[Days_Open] >= 60
			)
		formatString: 0
		lineageTag: 933ab4b6-7954-433f-8b4f-78b3fb7ac6f8

	measure 'On Hold Count' =
			
			CALCULATE(
			    DISTINCTCOUNT(R3_OnHold[Job Req ID]),
			    R3_OnHold[Requisition Status] = "Open"
			)
		formatString: 0
		lineageTag: 1cf239d9-c1de-405b-8cef-5d568f5506e1

	measure 'Avg Days Open' =
			
			CALCULATE(
			    AVERAGE(R1_Clean[Days_Open]),
			    R1_Clean[Requisition Status] = "Open"
			)
		lineageTag: e10edc67-cacb-44f5-a84f-0825bacc7ce3

		annotation PBI_FormatHint = {"isGeneralNumber":true}


	partition R1_Clean = m
		mode: import
		queryGroup: workfile
		source =
				let
				    Source = Excel.Workbook(File.Contents("C:\Users\DIMATM\OneDrive - Korn Ferry\Desktop\newmont\report_All_Global_REQ_New_Report_KF.xlsx")),
				    R1_Clean_Sheet = Source{[Item="R1_Clean",Kind="Sheet"]}[Data],
				    #"Promoted Headers" = Table.PromoteHeaders(R1_Clean_Sheet, [PromoteAllScalars=true]),
				    #"Trimmed Headers" = Table.TransformColumnNames(#"Promoted Headers", Text.Trim),
				    #"Set Types" = Table.TransformColumnTypes(#"Trimmed Headers", {
				        {"Job Req ID", type text},
				        {"SAP Position ID", type text},
				        {"Date Created", type date},
				        {"Approved Date", type date},
				        {"Closed Date", type date},
				        {"Age", Int64.Type},
				        {"Openings Filled", Int64.Type},
				        {"Time to Fill", type number}
				    }),
				    #"Renamed Columns" = Table.RenameColumns(#"Set Types", {
				        {"Age", "Days_Open"},
				        {"Career Site Filter Country", "Country"}
				    }, MissingField.Ignore),
				    #"Removed Helpers" = Table.RemoveColumns(#"Renamed Columns", {
				        "Duplicate?", "Date Used for Keep", "Keep?",
				        "Column42", "Row Labels", "Count of Job Req ID",
				        "Column45", "Validation Check", "Result"
				    }, MissingField.Ignore)
				in
				    #"Removed Helpers"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table


		isNameInferred
		sourceColumn: [Week Number]

		annotation SummarizationSetBy = Automatic

	partition DateTable = calculated
		mode: import
		source =
				
				VAR MinDate = DATE(2019, 10, 1)
				VAR MaxDate = DATE(2026, 12, 31)
				RETURN
				ADDCOLUMNS(
				    CALENDAR(MinDate, MaxDate),
				    "Year", YEAR([Date]),
				    "Month Number", MONTH([Date]),
				    "Month Name", FORMAT([Date], "MMMM"),
				    "Month Short", FORMAT([Date], "MMM"),
				    "Quarter", "Q" & FORMAT([Date], "Q"),
				    "Year-Month", FORMAT([Date], "YYYY-MM"),
				    "Year-Quarter", YEAR([Date]) & "-Q" & FORMAT([Date], "Q"),
				    "Fiscal Year", IF(MONTH([Date]) >= 7, YEAR([Date]) + 1, YEAR([Date])),
				    "Week Number", WEEKNUM([Date])
				)

	annotation PBI_Id = d0fc15b7998d410ea2f6b7da239a2f13


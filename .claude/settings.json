{
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "$c = Get-Content \"$env:CLAUDE_PROJECT_DIR\\.claude\\hooks\\precompact.md\" -Raw; @{hookSpecificOutput=@{hookEventName='PreCompact';additionalContext=$c}} | ConvertTo-Json -Compress",
            "timeout": 30,
            "statusMessage": "Preserving UNGASIS context before compaction"
          }
        ]
      }
    ]
  }
}

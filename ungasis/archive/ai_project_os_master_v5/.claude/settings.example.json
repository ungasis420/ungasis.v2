{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(curl * | sh)",
      "Bash(curl * | sh*)",
      "Bash(rm -rf *)",
      "Bash(wget * | sh)",
      "Read(./**/*credential*)",
      "Read(./**/*private-key*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./config/credentials.json)",
      "Read(./secrets/**)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(npm publish *)",
      "Bash(pnpm publish *)",
      "Bash(yarn publish *)",
      "Bash(terraform apply *)",
      "Bash(kubectl apply *)"
    ],
    "allow": [
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(npm test *)",
      "Bash(npm run test *)",
      "Bash(python scripts/verify_template.py)"
    ]
  },
  "aiProjectOsNotes": [
    "Keep CLAUDE.md concise; move procedures to skills.",
    "Enable hooks only after reviewing scripts locally.",
    "Use permissions.deny to keep secret files out of model context."
  ]
}
